# --- SentryLab-PVE Ignore Rules ---

# Sensitive configuration files (MUST NEVER BE UPLOADED)
config.conf
secrets.yaml

# Windows specific files
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# VS Code specific
.vscode/

# System and temporary files
*.log
.DS_Store
# Debian build output and local test caches
dist/
__pycache__/
*.pyc
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/sentrylab-pve/
debian/*.substvars
debian/*.debhelper
